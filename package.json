{
  "name": "glassy-session",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "vue-tsc --noEmit && wxt build",
    "build:firefox": "vue-tsc --noEmit && wxt build -b firefox",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "lint fix": "eslint --fix .",
    "test": "vitest",
    "test ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook build": "storybook build",
    "icons": "node --experimental-strip-types scripts/render-icons.ts"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.21",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.12",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.15.0",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "storybook": "^10.6.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pages": "^0.33.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  }
}
